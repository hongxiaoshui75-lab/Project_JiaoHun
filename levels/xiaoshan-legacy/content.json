      "intro": [
        {
          "speaker": "蔡瑞",
          "text": "小人只是奉命搜查、押送。不能把疑心都算在小人头上。"
        }
      ],
      "statements": [
        {
          "id": "opportunity_1",
          "speaker": "蔡瑞",
          "text": "我与和尚素无往来，谈不上有什么旧怨。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "没有旧怨，便不会在当天发生冲突？"
              },
              {
                "speaker": "蔡瑞",
                "text": "正一说索钱，小人并不认。"
              }
            ],
            "flags": [],
            "evidence": []
          },
          "expression": "alarmed"
        },
        {
          "id": "opportunity_2",
          "speaker": "蔡瑞",
          "text": "离庙后，我便将正一直接送到县衙，途中并未带回自己的住处。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "这一路是否另有停留？"
              },
              {
                "speaker": "蔡瑞",
                "text": "小人办差，自然是往衙门去。"
              }
            ],
            "flags": [],
            "evidence": []
          },
          "expression": "alarmed"
        },
        {
          "id": "opportunity_3",
          "speaker": "蔡瑞",
          "text": "超凡来讨时，行李早已归还；我没有继续扣着他的东西。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "他记得你提出了归还条件。"
              },
              {
                "speaker": "蔡瑞",
                "text": "他急着替和尚开脱，什么话都敢讲。"
              }
            ],
            "flags": [],
            "evidence": []
          },
          "expression": "alarmed"
        }
      ],
      "rules": [
        {
          "id": "rule_home",
          "statementId": "opportunity_2",
          "evidenceId": "testimony_home",
          "requires": [
            "home_examined",
            "motive_examined",
            "luggage_examined",
            "final_material_linked"
          ],
          "flags": [
            "evidence_chain_established"
          ],
          "evidence": [],
          "next": "confession",
          "lines": [
            {
              "speaker": "沈砚",
              "text": "正一亲历的去向与你不同：你把他和箱子带回自己家中，还继续索钱。超凡另能证明行李没有当即归还。",
              "expression": "assertive"
            },
            {
              "speaker": "沈砚",
              "text": "开箱与呈堂数量不符，材料又与帽缘有关；你的索钱指控和经手时段，都必须继续查清。",
              "expression": "assertive"
            },
            {
              "speaker": "蔡瑞",
              "text": "小人……他们两人的说法，就都可信么？",
              "expression": "sweating"
            },
            {
              "speaker": "曾日理",
              "text": "不是只信某一人，也不是只凭线色。把前后供词、物件和经手经过逐项核对。蔡瑞，留下再问。",
              "expression": "listening"
            }
          ]
        },
        {
          "id": "rule_luggage",
          "statementId": "opportunity_3",
          "evidenceId": "testimony_luggage",
          "requires": [
            "home_examined",
            "motive_examined",
            "luggage_examined",
            "final_material_linked"
          ],
          "flags": [
            "evidence_chain_established"
          ],
          "evidence": [],
          "next": "confession",
          "lines": [
            {
              "speaker": "沈砚",
              "text": "超凡记得你说：「你得找了那两个和尚来，才会给你。」这并不是已经归还。",
              "expression": "assertive"
            },
            {
              "speaker": "沈砚",
              "text": "正一另述自己被带回你家、继续遭到索钱。两人各自亲历的事，说明行李仍由你掌管。",
              "expression": "assertive"
            },
            {
              "speaker": "蔡瑞",
              "text": "那也不能……",
              "expression": "sweating"
            },
            {
              "speaker": "曾日理",
              "text": "剪刀数量、帽缘材料、索钱与行李经手的疑点既已相连，就要逐一查究。蔡瑞，留下再问。",
              "expression": "listening"
            }
          ]
        }
      ],
