  "stages": {
    "prologue": {
      "id": "prologue",
      "title": "前情 · 杭州巡抚衙门",
      "kind": "dialogue",
      "sourceClass": "G",
      "draft": true,
      "intro": [
        {
          "speaker": "案情",
          "text": "乾隆三十三年。叫魂传闻四起。四名化缘和尚被控剪辫，历经萧山县初审、绍兴府复审，押至杭州。"
        },
        {
          "speaker": "案情",
          "text": "呈堂的是四把剪刀和两段辫状物。和尚已受刑讯，供词反复；正一却始终指称捕役蔡瑞索钱栽赃。"
        },
        {
          "speaker": "曾日理",
          "text": "沈砚，先查核呈堂物件，再问清他们各自亲见何事。不可只凭疑心，也不可只凭一张供状。"
        }
      ],
      "next": "investigation",
      "backgroundAssetId": "background.exterior"
    },
    "investigation": {
      "id": "investigation",
      "title": "初次查办",
      "kind": "investigation",
      "sourceClass": "G",
      "draft": true,
      "intro": [
        {
          "speaker": "沈砚",
          "text": "先把实物与当事人的说法分开记录。东西在箱里，并不等于它的来历已经查清。"
        }
      ],
      "hint": "可在证物存放处、候审处与廊下之间移动。检查实物，也听取亲历者的陈述。",
      "requires": [
        "scissors_seen",
        "braids_seen",
        "braid_examined",
        "jucheng_heard",
        "zhengyi_heard",
        "chaofan_heard",
        "witness_seen"
      ],
      "next": "hearing_scissors",
      "locations": [
        {
          "id": "evidence_room",
          "name": "证物存放处",
          "description": "桌上放着随案移交的剪刀、辫状物和一只破锁箱子。",
          "interactions": [
            {
              "id": "inspect_scissors",
              "label": "查看剪刀",
              "kind": "调查",
              "lines": [
                {
                  "speaker": "沈砚",
                  "text": "四把，都是旧铁剪。仅凭这些剪刀，尚看不出它们究竟用来做过什么。",
                  "expression": "thinking"
                }
              ],
              "flags": [
                "scissors_seen"
              ],
              "evidence": [
                "scissors"
              ],
              "requires": [],
              "hotspot": {
                "x": 0.12,
                "y": 0.59,
                "w": 0.25,
                "h": 0.22
              }
            },
            {
              "id": "inspect_braids",
              "label": "查看两段辫状物",
              "kind": "调查",
              "lines": [
                {
                  "speaker": "沈砚",
                  "text": "两段都是黑褐色，乍看像剪下来的辫梢。尾端的细丝却不完全相同。",
                  "expression": "thinking"
                }
              ],
              "flags": [
                "braids_seen"
              ],
              "evidence": [
                "braids"
              ],
              "requires": [],
              "hotspot": {
                "x": 0.43,
                "y": 0.6,
                "w": 0.18,
                "h": 0.16
              }
            },
            {
              "id": "examine_braid_tail",
              "label": "细看辫状物的散尾",
              "kind": "调查",
              "lines": [
                {
                  "speaker": "沈砚",
                  "text": "这一段有细丝横纵交错的痕迹，还留着未拆净的短横线。它是织物的线，并非人发。",
                  "focusAssetId": "detail.braid_tail",
                  "expression": "thinking"
                },
                {
                  "speaker": "沈砚",
                  "text": "另一段确有发丝，但是否从活人的辫梢剪下、又是谁放进箱中，现在还不知道。",
                  "focusAssetId": "detail.braid_tail",
                  "expression": "thinking"
                }
              ],
              "flags": [
                "braid_examined"
              ],
              "evidence": [],
              "requires": [
                "braids_seen"
              ],
              "hotspot": {
                "x": 0.53,
                "y": 0.72,
                "w": 0.13,
                "h": 0.1
              }
            },
            {
              "id": "inspect_luggage",
              "label": "查看破锁行李箱",
              "kind": "调查",
              "lines": [
                {
                  "speaker": "沈砚",
                  "text": "锁扣已经砸坏。箱子曾被强行打开，但它后来经了谁的手，还得问当事人。",
                  "focusAssetId": "detail.lock",
                  "expression": "thinking"
                }
              ],
              "flags": [
                "luggage_seen"
              ],
              "evidence": [
                "luggage"
              ],
              "requires": [],
              "hotspot": {
                "x": 0.7,
                "y": 0.48,
                "w": 0.25,
                "h": 0.35
              }
            }
          ],
          "backgroundAssetId": "background.evidence_room"
        },
        {
          "id": "waiting_room",
          "name": "候审处",
          "description": "巨成、正一、超凡在此候审。几人带伤，对再次问话仍有惧意。",
          "interactions": [
            {
              "id": "talk_jucheng",
              "label": "询问剪刀与绳带的来历",
              "kind": "交谈",
              "lines": [
                {
                  "speaker": "巨成",
                  "text": "三把剪刀是我死去的儿子留下的，他生前做皮匠。第四把，我认不得。",
                  "expression": "worried"
                },
                {
                  "speaker": "巨成",
                  "text": "扎发的绳子，是我出家前用的旧物。那两段辫子，我也不知道是怎么回事。",
                  "expression": "worried"
                }
              ],
              "flags": [
                "jucheng_heard"
              ],
              "evidence": [
                "testimony_jucheng"
              ],
              "requires": [],
              "actor": "巨成"
            },
            {
              "id": "talk_zhengyi",
              "label": "询问拘捕经过",
              "kind": "交谈",
              "lines": [
                {
                  "speaker": "正一",
                  "text": "蔡捕役说，只要给几个规矩钱，就让我们走。我说：「我们是讨饭的和尚，哪里会有钱给你？」",
                  "expression": "insistent"
                },
                {
                  "speaker": "沈砚",
                  "text": "这是索钱的指控，须同搜查之后的经过一并查明。",
                  "expression": "thinking"
                }
              ],
              "flags": [
                "zhengyi_heard"
              ],
              "evidence": [
                "testimony_zhengyi"
              ],
              "requires": [],
              "actor": "正一"
            },
            {
              "id": "talk_chaofan",
              "label": "询问行李去向",
              "kind": "交谈",
              "lines": [
                {
                  "speaker": "超凡",
                  "text": "蔡捕役把正一和行李带走，我就跟上去讨要。他不肯给，我只好上衙门告状。",
                  "expression": "concerned"
                },
                {
                  "speaker": "沈砚",
                  "text": "你亲眼所见的去向与追讨经过，稍后还须详细说明。",
                  "expression": "thinking"
                }
              ],
              "flags": [
                "chaofan_heard"
              ],
              "evidence": [
                "testimony_chaofan"
              ],
              "requires": [],
              "actor": "超凡"
            }
          ],
          "backgroundAssetId": "background.waiting_room"
        },
        {
          "id": "corridor",
          "name": "衙门廊下",
          "description": "一名当日围观开箱的人被请来核对经过。",
          "interactions": [
            {
              "id": "talk_witness",
              "label": "询问开箱时看见的物件",
              "kind": "交谈",
              "lines": [
                {
                  "speaker": "围观者",
                  "text": "蔡捕役用石块砸开箱子，我当时挤在近旁，看见三把剪刀。第四把？我没见着。",
                  "expression": "recalling"
                },
                {
                  "speaker": "沈砚",
                  "text": "你后来是否一直跟着箱子？",
                  "expression": "thinking"
                },
                {
                  "speaker": "围观者",
                  "text": "没有。他带着和尚和行李走后，我就散了。后来的事我不知道。",
                  "expression": "recalling"
                }
              ],
              "flags": [
                "witness_seen"
              ],
              "evidence": [
                "testimony_witness"
              ],
              "requires": [],
              "actor": "围观者"
            }
          ],
          "backgroundAssetId": "background.corridor"
        }
      ],
      "presentResponses": [
        {
          "evidenceId": "scissors",
          "requires": [
            "jucheng_heard"
          ],
          "flags": [],
          "evidence": [],
          "lines": [
            {
              "speaker": "沈砚",
              "text": "据巨成的说明，三把为亡子旧物。第四把的来历还须查核。"
            }
          ],
          "actor": "巨成"
        },
        {
          "evidenceId": "braids",
          "requires": [
            "braid_examined"
          ],
          "flags": [],
          "evidence": [],
          "lines": [
            {
              "speaker": "沈砚",
              "text": "形似辫子，不等于就是从人的辫梢剪下。先记住材质上的差别。"
            }
          ]
        }
      ],
      "backgroundAssetId": "background.evidence_room"
    },
    "hearing_scissors": {
      "id": "hearing_scissors",
      "title": "普通会审 · 剪刀数量",
      "kind": "hearing",
      "pool": "ordinary",
      "resetPool": true,
      "sourceClass": "G",
      "draft": true,
      "intro": [
        {
          "speaker": "曾日理",
          "text": "蔡瑞，把搜查经过再说一遍。沈砚，有疑问便据实提出。"
        }
      ],
      "statements": [
        {
          "id": "scissors_1",
          "speaker": "蔡瑞",
          "text": "那日小人奉命搜查正一携带的行李。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "箱子是怎样打开的？"
              },
              {
                "speaker": "蔡瑞",
                "text": "锁着打不开，小人便用石块砸开。"
              }
            ],
            "flags": [],
            "evidence": []
          },
          "expression": "neutral"
        },
        {
          "id": "scissors_2",
          "speaker": "蔡瑞",
          "text": "砸开箱子后，便发现了四把剪刀。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "你说的四把，都是开箱当时看到的？"
              },
              {
                "speaker": "蔡瑞",
                "text": "呈上来的就是这些。小人岂会平白多说一把？"
              }
            ],
            "flags": [],
            "evidence": []
          },
          "expression": "neutral"
        },
        {
          "id": "scissors_3",
          "speaker": "蔡瑞",
          "text": "此外，还有扎辫子的绳带及两段辫子。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "物件的用途查过没有？"
              },
              {
                "speaker": "蔡瑞",
                "text": "和尚带着这些东西，岂不该查？"
              }
            ],
            "flags": [],
            "evidence": []
          },
          "expression": "neutral"
        },
        {
          "id": "scissors_4",
          "speaker": "蔡瑞",
          "text": "箱中物证俱在，小人不过据实呈报。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "呈报物件，与查明来历，是两回事。"
              },
              {
                "speaker": "蔡瑞",
                "text": "小人先把可疑物件呈上，自有大人明断。"
              }
            ],
