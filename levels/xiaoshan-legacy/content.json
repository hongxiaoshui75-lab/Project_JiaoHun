          "expression": "neutral"
        },
        {
          "id": "braid_2",
          "speaker": "蔡瑞",
          "text": "两段皆有发辫的形状，分明都是从人头上剪下来的。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "外形相似，材料也就一样？"
              },
              {
                "speaker": "蔡瑞",
                "text": "寻常发辫就是这般样子，小人当时哪会想到还有别的材料。"
              }
            ],
            "flags": [],
            "evidence": []
          },
          "expression": "neutral"
        },
        {
          "id": "braid_3",
          "speaker": "蔡瑞",
          "text": "和尚既带剪刀，又带辫子，小人据此起疑并无不妥。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "起疑之后，可曾逐一查清？"
              },
              {
                "speaker": "蔡瑞",
                "text": "小人负责查拿，东西已交到了堂上。"
              }
            ],
            "flags": [],
            "evidence": []
          },
          "expression": "neutral"
        }
      ],
      "rules": [
