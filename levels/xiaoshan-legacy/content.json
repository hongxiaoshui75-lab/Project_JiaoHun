      "statements": [
        {
          "id": "braid_1",
          "speaker": "蔡瑞",
          "text": "至于箱中的两段辫子，小人当时也都看过。",
          "press": {
            "lines": [
              {
                "speaker": "沈砚",
                "text": "你看过什么？"
              },
              {
                "speaker": "蔡瑞",
                "text": "两段编在一起的细丝，形状自然看得明白。"
