    "confession": {
      "id": "confession",
      "title": "继续查究",
      "kind": "dialogue",
      "sourceClass": "G",
      "draft": true,
      "intro": [
        {
          "speaker": "案情",
          "text": "堂上反复核对口供与经手经过。蔡瑞仍几番辩解，查问持续了许久。"
        },
        {
          "speaker": "曾日理",
          "text": "你为何将人带回家，又以找来另外两人为还物条件？第四把剪刀与这些编结物，究竟如何到了箱中？",
          "expression": "stern"
        },
        {
          "speaker": "蔡瑞",
          "text": "小人认了……本想讨几个钱。正一不肯，还说要告官。若不能说他真剪了辫子，小人便要惹上麻烦。",
          "expression": "exhausted"
        },
        {
          "speaker": "蔡瑞",
          "text": "我在家里找了旧头发，避开正一编成一段；又剪下自己帽檐的纤维，编成另一段。",
          "expression": "confession"
        },
        {
          "speaker": "蔡瑞",
          "text": "这两段东西，连同我自己的一把剪刀，都是后来放进和尚行李里的。",
          "expression": "confession"
        },
        {
          "speaker": "曾日理",
          "text": "将所供经过逐项记明，与呈堂物件核对。此案退回萧山县办理。",
          "expression": "stern"
        }
      ],
      "next": "ending_success",
      "backgroundAssetId": "background.court"
    },
